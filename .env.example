# ---- Brand (what customers see) -------------------------------------------
BRAND_NAME=Thesis Humanizer
SUPPORT_EMAIL=hello@yourbrand.com
PRICE_GHS=20
TURNAROUND=24 hours
MAX_FILE_MB=15

# ---- Paystack (Dashboard > Settings > API Keys & Webhooks) ----------------
# Use sk_test_... while testing, then switch to sk_live_...
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Where YOU receive paid documents (set up one or both) ----------------
# Telegram: create a bot with @BotFather, send it a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: use a separate brand Gmail with an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives new orders (defaults to SMTP_USER)
NOTIFY_EMAIL=

PORT=3000
